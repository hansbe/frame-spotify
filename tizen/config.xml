<?xml version="1.0" encoding="UTF-8"?>
<!-- Valgfri Samsung TV-app (Tizen) som åpner nettappen i fullskjerm, uten nettleserens adresselinje.
     Se README.md, avsnittet «Som egen TV-app». Bytt URL-en under hvis repoet heter noe annet. -->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://frame-spotify.vercel.app"
        version="1.0.0"
        viewmodes="maximized">
  <tizen:application id="FrmSptfy01.FrameSpotify" package="FrmSptfy01" required_version="4.0"/>
  <name>Frame Spotify</name>
  <icon src="icon.png"/>
  <content src="https://frame-spotify.vercel.app/"/>

  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>frame-spotify.vercel.app accounts.spotify.com *.spotify.com *.scdn.co</tizen:allow-navigation>

  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo"/>

  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
